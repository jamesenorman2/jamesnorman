{
  "crons": [
    {
      "path": "/api/night-shift",
      "schedule": "0 5 * * *"
    },
    {
      "path": "/api/research",
      "schedule": "30 6 * * *"
    },
    {
      "path": "/api/crew",
      "schedule": "15 7 * * *"
    }
  ],
  "functions": {
    "api/night-shift.js": {
      "maxDuration": 120,
      "includeFiles": "ABOUT.md"
    },
    "api/research.js": {
      "maxDuration": 300,
      "includeFiles": "ABOUT.md"
    },
    "api/crew.js": {
      "maxDuration": 300,
      "includeFiles": "ABOUT.md"
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), geolocation=(), payment=(), microphone=(self)"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/visualiser",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/visualiser/",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/agents",
      "destination": "/night-shift/",
      "permanent": false
    },
    {
      "source": "/agents/",
      "destination": "/night-shift/",
      "permanent": false
    },
    {
      "source": "/lib/:path*",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/package-lock.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/vercel.json",
      "destination": "/",
      "permanent": false
    },
    {
      "source": "/.vercelignore",
      "destination": "/",
      "permanent": false
    }
  ]
}
